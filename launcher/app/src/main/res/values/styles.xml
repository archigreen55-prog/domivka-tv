<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fully opaque, fullscreen. NEVER make the window translucent: on the target TV that leaves redraw trails. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@drawable/bg_sky</item>
        <item name="android:colorBackground">#FF050B1A</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:windowContentTransitions">false</item>
    </style>

    <style name="GlassDialog" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>
</resources>
